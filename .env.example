# Where the Go API lives. Server-side only: the browser never calls it directly.
# In Dokploy use the API's internal service address, e.g. http://baoswitch-api:8080
API_URL=http://localhost:8080

# Seals the pending sign-up cookie (it briefly carries the password between the
# code being sent and verified). Required in production, 32+ random characters:
#   openssl rand -base64 32
SESSION_SECRET=
